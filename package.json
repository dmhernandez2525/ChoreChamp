{
  "name": "chorechamp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@chorechamp/web",
    "dev:api": "turbo dev --filter=@chorechamp/api",
    "dev:mobile": "turbo dev --filter=@chorechamp/mobile",
    "build": "turbo build",
    "build:api": "turbo build --filter=@chorechamp/api",
    "build:web": "turbo build --filter=@chorechamp/web",
    "test": "turbo test",
    "test:api": "turbo test --filter=@chorechamp/api",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter=@chorechamp/database generate",
    "db:migrate": "pnpm --filter=@chorechamp/database migrate",
    "db:push": "pnpm --filter=@chorechamp/database push",
    "db:seed": "pnpm --filter=@chorechamp/database seed",
    "db:studio": "pnpm --filter=@chorechamp/database studio",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
