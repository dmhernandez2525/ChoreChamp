# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgres://user:password@localhost:5432/chorechamp

# Redis (for sessions and queues)
REDIS_URL=redis://localhost:6379

# better-auth
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# CORS
CORS_ORIGIN=http://localhost:5173

# Stripe (Subscriptions)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_FAMILY_MONTHLY=price_...
STRIPE_PRICE_FAMILY_ANNUAL=price_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_ANNUAL=price_...
STRIPE_PRICE_FAMILY_MONTHLY_GRANDFATHERED=price_...
STRIPE_PRICE_FAMILY_ANNUAL_GRANDFATHERED=price_...
STRIPE_PRICE_PREMIUM_MONTHLY_GRANDFATHERED=price_...
STRIPE_PRICE_PREMIUM_ANNUAL_GRANDFATHERED=price_...
SUBSCRIPTION_GRACE_PERIOD_DAYS=7
SUBSCRIPTION_GRANDFATHERED_CUTOFF_DATE=2026-03-01

# File uploads (S3-compatible)
S3_BUCKET=chorechamp-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
